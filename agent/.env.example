# Argus Agent — Environment Variables
# Copy to .env and fill in your keys

# DeepSeek API key (for Agent α + Agent β when not in DEMO_MODE)
DEEPSEEK_API_KEY=

# Etherscan API key (free tier) — for cross-chain contract data fetching
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Mainnet RPC URL for on-chain data fetching (uses public fallback if not set)
# MAINNET_RPC_URL=https://eth.llamarpc.com

# Arc testnet RPC
# ARC_RPC_URL=https://rpc.testnet.arc-node.thecanteenapp.com

# Treasury address (receives $0.01 scan fees)
# TREASURY_ADDRESS=0x0699a029e2e05EC88d6418EC744232702Cf77d81

# Gateway: set to 'true' for mainnet, omit for testnet
# GATEWAY_MAINNET=false

# Set to 'true' to skip LLM API calls and use deterministic fallbacks
# DEMO_MODE=true

# Agent signing keys (for nanopayments)
# AGENT_ALPHA_PRIVATE_KEY=
# AGENT_BETA_PRIVATE_KEY=
# AGENT_GAMMA_PRIVATE_KEY=

# Data directory (for persistent store)
# DATA_DIR=/argus-data
